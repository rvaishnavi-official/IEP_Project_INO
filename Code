// code for light sensor

int LDR = A2;
int LED_RED = 4;
int KNOB = A0;

int threshold = 1000;

void setup() {
  pinMode(LED_RED, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  int lightValue = analogRead(LDR);
  int knobValue = analogRead(KNOB);

  Serial.println(lightValue);  

  if (knobValue > 512) {
    digitalWrite(LED_RED, LOW);   
  } 
  else {
    if (lightValue > threshold) {
      digitalWrite(LED_RED, LOW);   
    } else {
      digitalWrite(LED_RED, HIGH); 
    }
  }

  delay(500);
}


