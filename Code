// add humidity sensor
int NTC = A1;
int LED_BLUE = 6;

void setup() {
  pinMode(LED_BLUE, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  int tempValue = analogRead(NTC);

  Serial.println(tempValue);

  if (tempValue < 200) {
    digitalWrite(LED_BLUE, LOW);
  }
  else {
    if (tempValue > 400) {
      digitalWrite(LED_BLUE, HIGH);
    }
    else {
      digitalWrite(LED_BLUE, LOW);
    }
  }

  delay(500);
}
