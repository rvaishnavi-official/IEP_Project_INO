// light sensor

int LDR = A2;
int LED_RED = 4;
int KNOB = A0;

// humidity sensor
int NTC = A1;
int LED_BLUE = 6;

void setup()
{
  pinMode(LED_RED, OUTPUT);
  pinMode(LED_BLUE, OUTPUT);
  Serial.begin(9600);
}

void loop()
{
  lightSensor();
}

void lightSensor()
{
  int lightReadings[3];
  int total = 0;

  for (int i = 0; i < 3; i++)
  {
    lightReadings[i] = analogRead(LDR);
    total += lightReadings[i];
  }

  int lightValue = total / 3;
  int knobValue = analogRead(KNOB);
  int LIGHT_THRESHOLD = 1000;

  Serial.println(lightValue);

  if (knobValue > 512)
  {
    digitalWrite(LED_RED, LOW);
  }
  else
  {
    if (lightValue > LIGHT_THRESHOLD)
    {
      digitalWrite(LED_RED, LOW);
    }
    else
    {
      digitalWrite(LED_RED, HIGH);
    }
  }
   int tempValue = analogRead(NTC);

  Serial.println(tempValue);

  if (tempValue < 200) {
    digitalWrite(LED_BLUE, LOW);
  }
  else {
    if (tempValue > 400) {
      digitalWrite(LED_BLUE, HIGH);
    }
    else {
      digitalWrite(LED_BLUE, LOW);
    }
  }

  delay(500);
}


